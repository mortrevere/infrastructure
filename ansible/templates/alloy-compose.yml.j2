---
services:
  alloy:
    image: docker.io/grafana/alloy:v1.16.1@sha256:41e0ad9b7c74cdc0a01ca8ce10f8d8262d49029167fd0b1d2db84a0f10468284
    user: "0:0"
    network_mode: host
    restart: unless-stopped
    command:
      - run
      - --server.http.listen-addr=127.0.0.1:12345
      - --storage.path=/var/lib/alloy
      - --disable-reporting
      - /etc/alloy/config.alloy
    volumes:
      - /etc/alloy/config.alloy:/etc/alloy/config.alloy:ro
      - /etc/machine-id:/etc/machine-id:ro
      - /var/log/journal:/var/log/journal:ro
      - /run/log/journal:/run/log/journal:ro
      - /var/log/nginx:/var/log/nginx:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/alloy:/var/lib/alloy
      - /etc/alloy/secrets/loki-password:/run/secrets/loki-password:ro
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
