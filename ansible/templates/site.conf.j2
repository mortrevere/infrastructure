server {
    listen 80;
    server_name {{ site.name }}{% if site.www | default(true) %} www.{{ site.name }}{% endif %};
    include /etc/nginx/snippets/infrastructure-security.conf;
    add_header Access-Control-Allow-Origin "https://leo.surf" always;

    location ^~ /.well-known/acme-challenge/ {
        root {{ certbot_webroot }};
        default_type text/plain;
    }

    location / {
        return 301 https://{{ site.name }}$request_uri;
    }
}
{% if tls_enabled | default(true) %}

server {
    listen 443 ssl;
    server_name {{ site.name }};
    include /etc/nginx/snippets/infrastructure-security.conf;
    include /etc/nginx/snippets/infrastructure-tls.conf;
    ssl_certificate {{ letsencrypt_live_dir }}/{{ site.name }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_live_dir }}/{{ site.name }}/privkey.pem;
    ssl_trusted_certificate {{ letsencrypt_live_dir }}/{{ site.name }}/chain.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% if site.upstream is defined %}

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_pass {{ site.upstream }};
    }
{% else %}
    root {{ nginx_html_root }}/{{ site.name }};
    index index.html index.htm;
    add_header Access-Control-Allow-Origin "https://leo.surf" always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers $http_access_control_request_headers always;

    if ($request_method = OPTIONS) {
        return 204;
    }
{% if site.no_cache | default(false) %}

    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    if_modified_since off;
    expires off;
    etag off;
{% endif %}
{% for location in site.locations | default([]) %}

    location {{ location.path }} {
        alias {{ location.alias }};
    }
{% endfor %}
{% if site.error_pages | default(false) %}

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root {{ nginx_html_root }};
    }
{% endif %}
{% endif %}
}
{% if site.www | default(true) %}

server {
    listen 443 ssl;
    server_name www.{{ site.name }};
    include /etc/nginx/snippets/infrastructure-tls.conf;
    ssl_certificate {{ letsencrypt_live_dir }}/{{ site.name }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_live_dir }}/{{ site.name }}/privkey.pem;
    ssl_trusted_certificate {{ letsencrypt_live_dir }}/{{ site.name }}/chain.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Access-Control-Allow-Origin "https://leo.surf" always;
    return 301 https://{{ site.name }}$request_uri;
}
{% endif %}
{% endif %}
